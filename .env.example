# Copy this file to ".env" (same folder) and fill in your values.
# .env is git-ignored - never commit it.

# LLM backend for the agents: "ollama" (local, free, offline) or "claude" (Anthropic API)
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=16384        # context window in tokens
# OLLAMA_THINK=false          # true = reasoning mode (better, much slower on CPU)
# OLLAMA_TIMEOUT_S=600

# --- Claude (Anthropic API, needs credits) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max
# CLAUDE_MAX_TOKENS=16000

# AGENT_MODE=narrate          # narrate | compact | evidence | tools (see README)
# AGENT_MAX_TOOL_ROUNDS=5
